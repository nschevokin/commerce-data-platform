# Copy to .env (git-ignored) for host-side commands against the Compose warehouse.
# Passwords are NOT set here: they live in ./secrets/ (scripts/init_local_secrets.sh).
WAREHOUSE_PORT=5432
COMMERCE_WAREHOUSE_HOST=127.0.0.1
COMMERCE_WAREHOUSE_PORT=5432
COMMERCE_WAREHOUSE_DB=commerce
COMMERCE_ADMIN_DSN_FILE=./secrets/warehouse_admin_dsn_host
COMMERCE_TRANSFORM_PASSWORD_FILE=./secrets/commerce_transform_password
# Integration tests: superuser DSN to a server they may create/drop throwaway databases on.
# COMMERCE_TEST_SERVER_DSN=host=127.0.0.1 port=5432 user=commerce_admin password=...
